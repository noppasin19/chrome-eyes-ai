{
  "manifest_version": 3,
  "name": "Chrome Eyes AI",
  "version": "2.0.0",
  "description": "Enterprise-grade real-time Google Chrome DOM inspector, Network monitor, and MCP Bridge for AI Agents.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chrome Eyes AI (v2.0.0)"
  }
}
